source "https://rubygems.org"

# Usa exactamente la misma versión de Jekyll/plugins que GitHub Pages,
# para que lo que veas en local sea lo que se publique.
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-sitemap"
  gem "jekyll-seo-tag"
  gem "jekyll-feed"
end

# Windows / Linux necesitan esto para las zonas horarias con github-pages
gem "tzinfo", ">= 1", "< 3"
gem "tzinfo-data"

gem "wdm", "~> 0.1.1", :platforms => [:mingw, :x64_mingw, :mswin]
